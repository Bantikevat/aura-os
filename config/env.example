# AURA Life OS Environment Configuration

# Server
PORT=3000
NODE_ENV=development

# AI / LLM Provider Configuration (Provider-Agnostic)
# Options: ollama (primary local, default) | gemini | groq | openai | none
LLM_PROVIDER=ollama

# Local Ollama Configuration (No API key required)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# Optional Cloud Providers (Leave blank to run 100% local/offline)
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
CUSTOM_BASE_URL=

# Intent Understanding
INTENT_CONFIDENCE_THRESHOLD=0.70

# Storage & Database
DATABASE_URL=file:./aura.sqlite

# Security & Trust
APPROVAL_TIMEOUT_MS=60000
AUDIT_LOG_LEVEL=verbose
