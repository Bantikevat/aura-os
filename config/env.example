# AURA Life OS Environment Configuration

# Server
PORT=3000
NODE_ENV=development

# LLM Providers (OpenAI Compatible / Gemini / Groq)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
CUSTOM_BASE_URL=

# Storage & Database
DATABASE_URL=file:./aura.sqlite

# Security & Trust
APPROVAL_TIMEOUT_MS=60000
AUDIT_LOG_LEVEL=verbose
